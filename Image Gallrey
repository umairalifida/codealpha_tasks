<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive Image Gallery</title>
<style>
  /* Reset & Base Styles */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #0f172a;
  color: #f8fafc;
  padding: 2rem 1rem;
  min-height: 100vh;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

h1 {
  text-align: center;
  margin-bottom: 1.5rem;
  font-size: 2.2rem;
}

/* Category Filters */
.filter-menu {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.filter-btn {
  background: #1e293b;
  color: #94a3b8;
  border: 1px solid #334155;
  padding: 0.5rem 1.25rem;
  border-radius: 9999px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.filter-btn:hover,
.filter-btn.active {
  background: #38bdf8;
  color: #0f172a;
  border-color: #38bdf8;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
}

/* Responsive CSS Layout (Grid) */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

/* Gallery Item, Hover Effects & Transitions */
.gallery-item {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background-color: #1e293b;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  cursor: pointer;
  aspect-ratio: 4 / 3;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.gallery-item.hide {
  display: none;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

/* Hover Zoom Effect */
.gallery-item:hover img {
  transform: scale(1.1);
}

.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(15, 23, 42, 0.85), transparent);
  opacity: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.25rem;
  transition: opacity 0.3s ease;
}

.gallery-item:hover .overlay {
  opacity: 1;
}

.overlay h3 {
  font-size: 1.1rem;
}

.overlay span {
  font-size: 0.85rem;
  color: #38bdf8;
  text-transform: capitalize;
}

/* Lightbox View */
.lightbox {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox.active {
  opacity: 1;
  pointer-events: auto;
}

.lightbox-content {
  position: relative;
  max-width: 90vw;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lightbox-img {
  max-width: 100%;
  max-height: 75vh;
  border-radius: 8px;
  object-fit: contain;
}

.caption {
  margin-top: 1rem;
  font-size: 1.1rem;
  color: #e2e8f0;
}

/* Navigation Buttons (Next / Prev) */
.close-btn,
.nav-btn {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border: none;
  font-size: 1.75rem;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: background 0.2s ease, transform 0.2s ease;
}

.close-btn:hover,
.nav-btn:hover {
  background: rgba(255, 255, 255, 0.25);
}

.close-btn {
  top: 20px;
  right: 20px;
}

.prev-btn {
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
}

.next-btn {
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
}

/* Responsive Rules for Small Screens */
@media (max-width: 600px) {
  .prev-btn { left: 10px; }
  .next-btn { right: 10px; }
  .nav-btn { width: 40px; height: 40px; font-size: 1.2rem; }
}
</style>
</head>
<body>

  <div class="container">
    <h1>Photo Gallery</h1>

    <!-- Category Filters (Bonus Requirement) -->
    <div class="filter-menu">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="nature">Nature</button>
      <button class="filter-btn" data-filter="architecture">Architecture</button>
      <button class="filter-btn" data-filter="city">City</button>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid">
      <div class="gallery-item" data-category="nature">
        <img src="https://picsum.photos/id/1015/600/400" alt="Mountain Lake">
        <div class="overlay">
          <h3>Mountain Lake</h3>
          <span>Nature</span>
        </div>
      </div>

      <div class="gallery-item" data-category="nature">
        <img src="https://picsum.photos/id/1043/600/400" alt="Forest Pathway">
        <div class="overlay">
          <h3>Forest Trail</h3>
          <span>Nature</span>
        </div>
      </div>

      <div class="gallery-item" data-category="architecture">
        <img src="https://picsum.photos/id/1040/600/400" alt="Modern Building">
        <div class="overlay">
          <h3>Modern Castle</h3>
          <span>Architecture</span>
        </div>
      </div>

      <div class="gallery-item" data-category="city">
        <img src="https://picsum.photos/id/1031/600/400" alt="City Lights">
        <div class="overlay">
          <h3>City Street</h3>
          <span>City</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal (JS Navigation & View) -->
  <div class="lightbox" id="lightbox">
    <button class="close-btn" id="closeBtn">&times;</button>
    <button class="nav-btn prev-btn" id="prevBtn">&#10094;</button>
    <div class="lightbox-content">
      <img src="" alt="" class="lightbox-img" id="lightboxImg">
      <div class="caption" id="lightboxCaption"></div>
    </div>
    <button class="nav-btn next-btn" id="nextBtn">&#10095;</button>
  </div>

  <script src="script.js">

    // Selecting DOM Elements
const filterBtns = document.querySelectorAll('.filter-btn');
const galleryItems = document.querySelectorAll('.gallery-item');
const lightbox = document.getElementById('lightbox');
const lightboxImg = document.getElementById('lightboxImg');
const lightboxCaption = document.getElementById('lightboxCaption');
const closeBtn = document.getElementById('closeBtn');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');

let visibleItems = [];
let currentIndex = 0;

// Update Array of Active Filtered Items
function updateVisibleItems() {
  visibleItems = Array.from(galleryItems).filter(item => !item.classList.contains('hide'));
}

// Category Filter Feature
filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const filterValue = btn.getAttribute('data-filter');

    galleryItems.forEach(item => {
      const category = item.getAttribute('data-category');
      if (filterValue === 'all' || category === filterValue) {
        item.classList.remove('hide');
      } else {
        item.classList.add('hide');
      }
    });

    updateVisibleItems();
  });
});

// Initialize active list
updateVisibleItems();

// Lightbox Open Event
galleryItems.forEach(item => {
  item.addEventListener('click', () => {
    currentIndex = visibleItems.indexOf(item);
    if (currentIndex !== -1) {
      showLightboxItem(currentIndex);
      lightbox.classList.add('active');
    }
  });
});

function showLightboxItem(index) {
  const targetItem = visibleItems[index];
  const img = targetItem.querySelector('img');
  const title = targetItem.querySelector('.overlay h3').textContent;

  lightboxImg.src = img.src;
  lightboxImg.alt = img.alt;
  lightboxCaption.textContent = title;
}

// Navigation Functions (Next / Prev)
function showNext() {
  if (visibleItems.length === 0) return;
  currentIndex = (currentIndex + 1) % visibleItems.length;
  showLightboxItem(currentIndex);
}

function showPrev() {
  if (visibleItems.length === 0) return;
  currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
  showLightboxItem(currentIndex);
}

function closeLightbox() {
  lightbox.classList.remove('active');
}

// Event Listeners for Controls
nextBtn.addEventListener('click', showNext);
prevBtn.addEventListener('click', showPrev);
closeBtn.addEventListener('click', closeLightbox);

lightbox.addEventListener('click', (e) => {
  if (e.target === lightbox) closeLightbox();
});

// Keyboard Navigation (Arrow Keys & Escape)
document.addEventListener('keydown', (e) => {
  if (!lightbox.classList.contains('active')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowRight') showNext();
  if (e.key === 'ArrowLeft') showPrev();
});
  </script>
</body>
</html>
